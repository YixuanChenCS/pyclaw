##########################################################
# Sample pyclaw .env file.
# Place at the root of your git repo.
# Or use `pyclaw --env <fname>` to specify.
##########################################################

#################
# LLM parameters:
#
# Include xxx_API_KEY parameters and other params needed for your LLMs.
# See https://pyclaw.chat/docs/llms.html for details.

## OpenAI
#OPENAI_API_KEY=

## Anthropic
#ANTHROPIC_API_KEY=

##...

#############
# Main model:

## Specify the model to use for the main chat
#PYCLAW_MODEL=

########################
# API Keys and settings:

## Specify the OpenAI API key
#PYCLAW_OPENAI_API_KEY=

## Specify the Anthropic API key
#PYCLAW_ANTHROPIC_API_KEY=

## Specify the api base url
#PYCLAW_OPENAI_API_BASE=

## (deprecated, use --set-env OPENAI_API_TYPE=<value>)
#PYCLAW_OPENAI_API_TYPE=

## (deprecated, use --set-env OPENAI_API_VERSION=<value>)
#PYCLAW_OPENAI_API_VERSION=

## (deprecated, use --set-env OPENAI_API_DEPLOYMENT_ID=<value>)
#PYCLAW_OPENAI_API_DEPLOYMENT_ID=

## (deprecated, use --set-env OPENAI_ORGANIZATION=<value>)
#PYCLAW_OPENAI_ORGANIZATION_ID=

## Set an environment variable (to control API settings, can be used multiple times)
#PYCLAW_SET_ENV=

## Set an API key for a provider (eg: --api-key provider=<key> sets PROVIDER_API_KEY=<key>)
#PYCLAW_API_KEY=

#################
# Model settings:

## List known models which match the (partial) MODEL name
#PYCLAW_LIST_MODELS=

## Specify a file with pyclaw model settings for unknown models
#PYCLAW_MODEL_SETTINGS_FILE=.pyclaw.model.settings.yml

## Specify a file with context window and costs for unknown models
#PYCLAW_MODEL_METADATA_FILE=.pyclaw.model.metadata.json

## Add a model alias (can be used multiple times)
#PYCLAW_ALIAS=

## Set the reasoning_effort API parameter (default: not set)
#PYCLAW_REASONING_EFFORT=

## Set the thinking token budget for models that support it. Use 0 to disable. (default: not set)
#PYCLAW_THINKING_TOKENS=

## Verify the SSL cert when connecting to models (default: True)
#PYCLAW_VERIFY_SSL=true

## Timeout in seconds for API calls (default: None)
#PYCLAW_TIMEOUT=

## Specify what edit format the LLM should use (default depends on model)
#PYCLAW_EDIT_FORMAT=

## Use architect edit format for the main chat
#PYCLAW_ARCHITECT=

## Enable/disable automatic acceptance of architect changes (default: True)
#PYCLAW_AUTO_ACCEPT_ARCHITECT=true

## Specify the model to use for commit messages and chat history summarization (default depends on --model)
#PYCLAW_WEAK_MODEL=

## Specify the model to use for editor tasks (default depends on --model)
#PYCLAW_EDITOR_MODEL=

## Specify the edit format for the editor model (default: depends on editor model)
#PYCLAW_EDITOR_EDIT_FORMAT=

## Only work with models that have meta-data available (default: True)
#PYCLAW_SHOW_MODEL_WARNINGS=true

## Check if model accepts settings like reasoning_effort/thinking_tokens (default: True)
#PYCLAW_CHECK_MODEL_ACCEPTS_SETTINGS=true

## Soft limit on tokens for chat history, after which summarization begins. If unspecified, defaults to the model's max_chat_history_tokens.
#PYCLAW_MAX_CHAT_HISTORY_TOKENS=

#################
# Cache settings:

## Enable caching of prompts (default: False)
#PYCLAW_CACHE_PROMPTS=false

## Number of times to ping at 5min intervals to keep prompt cache warm (default: 0)
#PYCLAW_CACHE_KEEPALIVE_PINGS=false

###################
# Repomap settings:

## Suggested number of tokens to use for repo map, use 0 to disable
#PYCLAW_MAP_TOKENS=

## Control how often the repo map is refreshed. Options: auto, always, files, manual (default: auto)
#PYCLAW_MAP_REFRESH=auto

## Multiplier for map tokens when no files are specified (default: 2)
#PYCLAW_MAP_MULTIPLIER_NO_FILES=true

################
# History Files:

## Specify the chat input history file (default: .pyclaw.input.history)
#PYCLAW_INPUT_HISTORY_FILE=.pyclaw.input.history

## Specify the chat history file (default: .pyclaw.chat.history.md)
#PYCLAW_CHAT_HISTORY_FILE=.pyclaw.chat.history.md

## Restore the previous chat history messages (default: False)
#PYCLAW_RESTORE_CHAT_HISTORY=false

## Log the conversation with the LLM to this file (for example, .pyclaw.llm.history)
#PYCLAW_LLM_HISTORY_FILE=

##################
# Output settings:

## Use colors suitable for a dark terminal background (default: False)
#PYCLAW_DARK_MODE=false

## Use colors suitable for a light terminal background (default: False)
#PYCLAW_LIGHT_MODE=false

## Enable/disable pretty, colorized output (default: True)
#PYCLAW_PRETTY=true

## Enable/disable streaming responses (default: True)
#PYCLAW_STREAM=true

## Set the color for user input (default: #00cc00)
#PYCLAW_USER_INPUT_COLOR=#00cc00

## Set the color for tool output (default: None)
#PYCLAW_TOOL_OUTPUT_COLOR=

## Set the color for tool error messages (default: #FF2222)
#PYCLAW_TOOL_ERROR_COLOR=#FF2222

## Set the color for tool warning messages (default: #FFA500)
#PYCLAW_TOOL_WARNING_COLOR=#FFA500

## Set the color for assistant output (default: #0088ff)
#PYCLAW_ASSISTANT_OUTPUT_COLOR=#0088ff

## Set the color for the completion menu (default: terminal's default text color)
#PYCLAW_COMPLETION_MENU_COLOR=

## Set the background color for the completion menu (default: terminal's default background color)
#PYCLAW_COMPLETION_MENU_BG_COLOR=

## Set the color for the current item in the completion menu (default: terminal's default background color)
#PYCLAW_COMPLETION_MENU_CURRENT_COLOR=

## Set the background color for the current item in the completion menu (default: terminal's default text color)
#PYCLAW_COMPLETION_MENU_CURRENT_BG_COLOR=

## Set the markdown code theme (default: default, other options include monokai, solarized-dark, solarized-light, or a Pygments builtin style, see https://pygments.org/styles for available themes)
#PYCLAW_CODE_THEME=default

## Show diffs when committing changes (default: False)
#PYCLAW_SHOW_DIFFS=false

###############
# Git settings:

## Enable/disable looking for a git repo (default: True)
#PYCLAW_GIT=true

## Enable/disable adding .pyclaw* to .gitignore (default: True)
#PYCLAW_GITIGNORE=true

## Enable/disable the addition of files listed in .gitignore to Pyclaw's editing scope.
#PYCLAW_ADD_GITIGNORE_FILES=false

## Specify the pyclaw ignore file (default: .pyclawignore in git root)
#PYCLAW_PYCLAWIGNORE=.pyclawignore

## Only consider files in the current subtree of the git repository
#PYCLAW_SUBTREE_ONLY=false

## Enable/disable auto commit of LLM changes (default: True)
#PYCLAW_AUTO_COMMITS=true

## Enable/disable commits when repo is found dirty (default: True)
#PYCLAW_DIRTY_COMMITS=true

## Attribute pyclaw code changes in the git author name (default: True). If explicitly set to True, overrides --attribute-co-authored-by precedence.
#PYCLAW_ATTRIBUTE_AUTHOR=

## Attribute pyclaw commits in the git committer name (default: True). If explicitly set to True, overrides --attribute-co-authored-by precedence for pyclaw edits.
#PYCLAW_ATTRIBUTE_COMMITTER=

## Prefix commit messages with 'pyclaw: ' if pyclaw authored the changes (default: False)
#PYCLAW_ATTRIBUTE_COMMIT_MESSAGE_AUTHOR=false

## Prefix all commit messages with 'pyclaw: ' (default: False)
#PYCLAW_ATTRIBUTE_COMMIT_MESSAGE_COMMITTER=false

## Attribute pyclaw edits using the Co-authored-by trailer in the commit message (default: True). If True, this takes precedence over default --attribute-author and --attribute-committer behavior unless they are explicitly set to True.
#PYCLAW_ATTRIBUTE_CO_AUTHORED_BY=true

## Enable/disable git pre-commit hooks with --no-verify (default: False)
#PYCLAW_GIT_COMMIT_VERIFY=false

## Commit all pending changes with a suitable commit message, then exit
#PYCLAW_COMMIT=false

## Specify a custom prompt for generating commit messages
#PYCLAW_COMMIT_PROMPT=

## Perform a dry run without modifying files (default: False)
#PYCLAW_DRY_RUN=false

## Skip the sanity check for the git repository (default: False)
#PYCLAW_SKIP_SANITY_CHECK_REPO=false

## Enable/disable watching files for ai coding comments (default: False)
#PYCLAW_WATCH_FILES=false

########################
# Fixing and committing:

## Lint and fix provided files, or dirty files if none provided
#PYCLAW_LINT=false

## Specify lint commands to run for different languages, eg: "python: flake8 --select=..." (can be used multiple times)
#PYCLAW_LINT_CMD=

## Enable/disable automatic linting after changes (default: True)
#PYCLAW_AUTO_LINT=true

## Specify command to run tests
#PYCLAW_TEST_CMD=

## Enable/disable automatic testing after changes (default: False)
#PYCLAW_AUTO_TEST=false

## Run tests, fix problems found and then exit
#PYCLAW_TEST=false

############
# Analytics:

## Enable/disable analytics for current session (default: random)
#PYCLAW_ANALYTICS=

## Specify a file to log analytics events
#PYCLAW_ANALYTICS_LOG=

## Permanently disable analytics
#PYCLAW_ANALYTICS_DISABLE=false

## Send analytics to custom PostHog instance
#PYCLAW_ANALYTICS_POSTHOG_HOST=

## Send analytics to custom PostHog project
#PYCLAW_ANALYTICS_POSTHOG_PROJECT_API_KEY=

############
# Upgrading:

## Check for updates and return status in the exit code
#PYCLAW_JUST_CHECK_UPDATE=false

## Check for new pyclaw versions on launch
#PYCLAW_CHECK_UPDATE=true

## Show release notes on first run of new version (default: None, ask user)
#PYCLAW_SHOW_RELEASE_NOTES=

## Install the latest version from the main branch
#PYCLAW_INSTALL_MAIN_BRANCH=false

## Upgrade pyclaw to the latest version from PyPI
#PYCLAW_UPGRADE=false

########
# Modes:

## Specify a single message to send the LLM, process reply then exit (disables chat mode)
#PYCLAW_MESSAGE=

## Specify a file containing the message to send the LLM, process reply, then exit (disables chat mode)
#PYCLAW_MESSAGE_FILE=

## Run pyclaw in your browser (default: False)
#PYCLAW_GUI=false

## Enable automatic copy/paste of chat between pyclaw and web UI (default: False)
#PYCLAW_COPY_PASTE=false

## Apply the changes from the given file instead of running the chat (debug)
#PYCLAW_APPLY=

## Apply clipboard contents as edits using the main model's editor format
#PYCLAW_APPLY_CLIPBOARD_EDITS=false

## Do all startup activities then exit before accepting user input (debug)
#PYCLAW_EXIT=false

## Print the repo map and exit (debug)
#PYCLAW_SHOW_REPO_MAP=false

## Print the system prompts and exit (debug)
#PYCLAW_SHOW_PROMPTS=false

#################
# Voice settings:

## Audio format for voice recording (default: wav). webm and mp3 require ffmpeg
#PYCLAW_VOICE_FORMAT=wav

## Specify the language for voice using ISO 639-1 code (default: auto)
#PYCLAW_VOICE_LANGUAGE=en

## Specify the input device name for voice recording
#PYCLAW_VOICE_INPUT_DEVICE=

#################
# Other settings:

## Never prompt for or attempt to install Playwright for web scraping (default: False).
#PYCLAW_DISABLE_PLAYWRIGHT=false

## specify a file to edit (can be used multiple times)
#PYCLAW_FILE=

## specify a read-only file (can be used multiple times)
#PYCLAW_READ=

## Use VI editing mode in the terminal (default: False)
#PYCLAW_VIM=false

## Specify the language to use in the chat (default: None, uses system settings)
#PYCLAW_CHAT_LANGUAGE=

## Specify the language to use in the commit message (default: None, user language)
#PYCLAW_COMMIT_LANGUAGE=

## Always say yes to every confirmation
#PYCLAW_YES_ALWAYS=

## Enable verbose output
#PYCLAW_VERBOSE=false

## Load and execute /commands from a file on launch
#PYCLAW_LOAD=

## Specify the encoding for input and output (default: utf-8)
#PYCLAW_ENCODING=utf-8

## Line endings to use when writing files (default: platform)
#PYCLAW_LINE_ENDINGS=platform

## Specify the .env file to load (default: .env in git root)
#PYCLAW_ENV_FILE=.env

## Enable/disable suggesting shell commands (default: True)
#PYCLAW_SUGGEST_SHELL_COMMANDS=true

## Enable/disable fancy input with history and completion (default: True)
#PYCLAW_FANCY_INPUT=true

## Enable/disable multi-line input mode with Meta-Enter to submit (default: False)
#PYCLAW_MULTILINE=false

## Enable/disable terminal bell notifications when LLM responses are ready (default: False)
#PYCLAW_NOTIFICATIONS=false

## Specify a command to run for notifications instead of the terminal bell. If not specified, a default command for your OS may be used.
#PYCLAW_NOTIFICATIONS_COMMAND=

## Enable/disable detection and offering to add URLs to chat (default: True)
#PYCLAW_DETECT_URLS=true

## Specify which editor to use for the /editor command
#PYCLAW_EDITOR=

## Print shell completion script for the specified SHELL and exit. Supported shells: bash, tcsh, zsh. Example: pyclaw --shell-completions bash
#PYCLAW_SHELL_COMPLETIONS=

############################
# Deprecated model settings:

## Use claude-3-opus-20240229 model for the main chat (deprecated, use --model)
#PYCLAW_OPUS=false

